rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Subscription status is server-authoritative -- only the Stripe webhook
    // (via the Admin SDK, which bypasses these rules entirely) may ever write
    // it. A client can read its own status to drive the paywall, but must
    // never be able to grant itself entitlement directly.
    match /subscriptions/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    // WhatsApp settings are set by the operator (console/Admin SDK), never by
    // the client. The owner may read their own so the app can show status.
    // whatsappLog (sent/failed audit trail) has no rule at all = denied to
    // every client; only the Cloud Function (Admin SDK) touches it.
    match /whatsappConfig/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}

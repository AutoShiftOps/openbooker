{
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs20"
    }
  ],
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", ".firebaserc", "**/.*", ".git/**", ".claude/**", ".firebase/**", "node_modules/**", "functions/**", "tests/**", "README.md", "*.dc.html", "support.js"],
    "rewrites": [
      { "source": "/", "destination": "/index.html" }
    ],
    "headers": [
      { "source": "**/*.@(js|json)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  }
}
